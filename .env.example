SECRET_KEY=
DEBUG=
DATABASE_URL=
GEMINI_API_KEY=
ALLOWED_HOSTS=

GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# reCAPTCHA v2 (kayıt formu). DEBUG=True iken boş bırakılırsa Google'ın herkese
# açık test anahtarları kullanılır (gerçek koruma sağlamaz). Production'da zorunlu.
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Google ile giriş (opsiyonel). Boş bırakılırsa buton hiç görünmez.
# https://console.cloud.google.com/apis/credentials → OAuth Client ID (Web application).
GOOGLE_CLIENT_ID=

# Gmail SMTP (kayıt doğrulama ve şifre sıfırlama e-postaları). GMAIL_APP_PASSWORD,
# hesap parolası değil bir "uygulama şifresi"dir: myaccount.google.com/apppasswords
# (iki adımlı doğrulama açık olmalı). DEBUG=True iken boş bırakılırsa e-postalar
# sunucu konsoluna yazılır. Production'da zorunlu.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
